# Copy to .env and fill in. Never commit .env.
DNB_SECRET_KEY=change-me
DNB_ALLOWED_HOSTS=localhost,127.0.0.1
DNB_TIME_ZONE=America/Los_Angeles
# Full path to the SQLite file (default: data/dnb.sqlite3 inside the project)
DNB_DB_PATH=
# Folder that is synced to the cloud (Google Drive, OneDrive, Dropbox)
DNB_BACKUP_DIR=
# Generate with: uv run python manage.py generate_backup_key
DNB_BACKUP_KEY=
