# Copy to .env and fill in. Never commit .env.
DNB_SECRET_KEY=change-me
DNB_ALLOWED_HOSTS=localhost,127.0.0.1
# Reached through a Cloudflare Tunnel? Add the public host above (books.example.com) and its https:// address here,
# and don't override the Host header on the tunnel rule. Blank when only used on the office network.
DNB_CSRF_TRUSTED_ORIGINS=
DNB_TIME_ZONE=America/Los_Angeles
# DNB_DB_PATH and DNB_BACKUP_DIR are set by the Docker image (/data). Set them only when running outside Docker.
# Generate with: docker compose exec -u dnb app python manage.py generate_backup_key
DNB_BACKUP_KEY=
# Off-site copy through rclone (see README, "Connect Google Drive"). Blank keeps backups local only.
DNB_BACKUP_REMOTE=
# Scheduler times, server time zone, HH:MM
DNB_BACKUP_TIME=01:15
DNB_DRILL_TIME=02:15
# Banking (Phase 5a). Plaid keys are optional: without them, file import still works.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
# Generate with: docker compose exec -u dnb app python manage.py generate_field_key
DNB_FIELD_KEY=
# Bank sync times, server time zone, HH:MM, comma separated
DNB_BANK_SYNC_TIMES=06:00,10:00,14:00,18:00
# Claude (MCP) service, behind Cloudflare Access (see README, "Use DNB Books from Claude").
# Team domain, like yourteam.cloudflareaccess.com, and the Access application's AUD tag.
DNB_CF_ACCESS_TEAM_DOMAIN=
DNB_CF_ACCESS_AUD=
# Public hostname(s) of the MCP service, comma separated
DNB_MCP_ALLOWED_HOSTS=mcp.example.com
# Main app address for Claude upload links, like https://books.example.com. Leave empty to turn links off.
DNB_APP_URL=
